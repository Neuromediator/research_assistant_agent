# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit real keys.

# Required — Anthropic API key for Sonnet 4.6 + Haiku 4.5.
# Get one at https://console.anthropic.com/account/keys.
# Set a hard monthly spend cap on the same console (recommended $20/mo).
ANTHROPIC_API_KEY=sk-ant-...

# Required — Serper.dev API key for Google web search.
# Free tier (2500 queries/mo) is enough for portfolio use.
# Get one at https://serper.dev/api-key.
SERPER_API_KEY=...

# Optional — Langfuse tracing. Without these the app runs fine but
# without observability. Get keys at https://cloud.langfuse.com after
# creating a project.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Region: EU is default. US users use https://us.cloud.langfuse.com.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
